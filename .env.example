# 复制本文件为 .env，然后把占位内容替换成你自己的真实配置。
# 注意：.env 已经被 .gitignore 忽略，不应该提交到 GitHub。

# DeepSeek API Key
DEEPSEEK_API_KEY=sk-0d4dbba6da8544c2abcd4338c87b6b55

# DeepSeek API 基础地址，通常不用改。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型名，可以根据官方最新模型列表调整。
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：Semantic Scholar API Key。没有也能访问公开接口，但更容易限流。
SEMANTIC_SCHOLAR_API_KEY=

# 可选：OpenAlex API Key。没有也能尝试公开接口。
OPENALEX_API_KEY=
